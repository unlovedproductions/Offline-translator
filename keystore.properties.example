# Copy to keystore.properties (gitignored) and fill in real values.
# Generate a keystore once and back it up offline. Losing it blocks updates.
#
# keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias puente
#
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=puente
keyPassword=CHANGE_ME
